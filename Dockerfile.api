FROM node:20-slim AS builder
WORKDIR /app

# Copy all workspace package manifests (required for npm ci to match lock file)
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/
COPY services/wa-sessions/package*.json ./services/wa-sessions/

# Override NODE_ENV so npm installs devDependencies (tsc, nest cli, etc.)
# Coolify injects NODE_ENV=production at build time which skips devDeps
RUN NODE_ENV=development npm ci

# Make root workspace binaries available (nest, tsc live in root node_modules/.bin)
ENV PATH="/app/node_modules/.bin:${PATH}"

# Copy source for the packages we need to build
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared first (API depends on its types)
WORKDIR /app/packages/shared
RUN npm run build

# Build API
WORKDIR /app/apps/api
RUN npm run build

# Slim production image
FROM node:20-slim
WORKDIR /app
COPY --from=builder /app/apps/api/dist ./dist
# npm workspaces hoists all deps to root node_modules, not apps/api/node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json .
ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000
CMD ["node", "dist/main.js"]
