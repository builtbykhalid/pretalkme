FROM node:20-slim AS builder
WORKDIR /app

# Copy all workspace package manifests (required for npm ci to match lock file)
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/
COPY services/wa-sessions/package*.json ./services/wa-sessions/

# Full install — includes devDependencies (tsc, nest cli, etc.)
RUN npm ci

# Copy source for the packages we need to build
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build shared first (API depends on its types)
WORKDIR /app/packages/shared
RUN npm run build

# Build API
WORKDIR /app/apps/api
RUN npm run build

# Slim production image
FROM node:20-slim
WORKDIR /app
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json .
ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000
CMD ["node", "dist/main.js"]
