# ============================================================
# pretalkme — Variables d'environnement DEPLOY DEV
# Copier ce fichier en .env.production et remplir les valeurs
# À injecter dans Coolify comme "Environment Variables"
# ============================================================

# --- Supabase (REQUIS — sans ça l'app ne démarre pas) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- URLs publiques du deploy dev ---
# Remplacer par les vraies URLs Coolify/serveur
API_PUBLIC_URL=https://api-dev.pretalk.me
WS_PUBLIC_URL=wss://api-dev.pretalk.me
CORS_ORIGIN=https://app-dev.pretalk.me

# --- RabbitMQ (service interne Docker) ---
RABBITMQ_USER=pretalkme
RABBITMQ_PASS=change_me_secret

# --- Meta WhatsApp (DIFFÉRÉ — laisser vide pour dev) ---
META_VERIFY_TOKEN=pretalkme_webhook_verify_2026
META_APP_SECRET=

# --- Email Resend (DIFFÉRÉ — laisser vide, emails échouent silencieusement) ---
RESEND_API_KEY=

# --- IA (DIFFÉRÉ — laisser vide, pipeline IA échoue silencieusement) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Stripe (DÉSACTIVÉ pour dev) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
