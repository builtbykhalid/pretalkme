---
import '../../../components/ReactApp/index.css';
import Blog from '../../../components/Landing/pages/Blog';
import LandingLayout from '../../../components/ReactApp/components/layout/LandingLayout';
import { supabase } from '../../../components/ReactApp/lib/supabase';

const { slug } = Astro.params;

const { data: category } = await supabase
  .from('blog_categories')
  .select('*')
  .eq('slug', slug)
  .single();

if (!category) {
  return Astro.redirect('/blog');
}

const { data: posts } = await supabase
  .from('blog_posts')
  .select('*, blog_categories(*)')
  .eq('category_id', category.id)
  .eq('status', 'published')
  .order('published_at', { ascending: false });
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{category.name} - Blog PreTalk</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-black">
    <LandingLayout client:load forceScrolled={true}>
      <div class="pt-20 bg-white">
        <div class="max-w-7xl mx-auto px-6 md:px-8 mt-12 bg-neutral-50 p-12 rounded-[40px] border border-neutral-100 relative overflow-hidden">
          <div 
            class="absolute top-0 right-0 w-64 h-64 opacity-10 blur-[80px] translate-x-1/2 -translate-y-1/2"
            style={{ backgroundColor: category.color }}
          />
          <div class="relative z-10">
            <a href="/blog/categories" class="text-xs font-bold text-neutral-400 hover:text-dark transition-colors mb-4 block">← Toutes les catégories</a>
            <h1 class="text-4xl md:text-5xl font-black text-dark tracking-tighter mb-4">
              Articles sur : <span style={{ color: category.color }}>{category.name}</span>
            </h1>
            <p class="text-neutral-500 font-medium max-w-2xl text-lg">
              {category.description || `Retrouvez tous nos contenus dédiés à la thématique ${category.name}.`}
            </p>
          </div>
        </div>
      </div>
      <Blog client:load initialPosts={posts || []} showHero={false} showFilters={false} showNewsletter={false} />
    </LandingLayout>
  </body>
</html>
