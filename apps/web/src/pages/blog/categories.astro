---
import '../../components/ReactApp/index.css';
import BlogCategories from '../../components/Landing/pages/BlogCategories';
import LandingLayout from '../../components/ReactApp/components/layout/LandingLayout';
import { supabase } from '../../components/ReactApp/lib/supabase';

const { data: categories } = await supabase
  .from('blog_categories')
  .select('*')
  .order('name');
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catégories Blog - PreTalk</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-black">
    <LandingLayout client:load forceScrolled={true}>
      <BlogCategories client:load categories={categories || []} />
    </LandingLayout>
  </body>
</html>
