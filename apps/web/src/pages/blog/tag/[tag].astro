---
import '../../../components/ReactApp/index.css';
import Blog from '../../../components/Landing/pages/Blog';
import LandingLayout from '../../../components/ReactApp/components/layout/LandingLayout';
import { supabase } from '../../../components/ReactApp/lib/supabase';

const { tag } = Astro.params;

// Search for the tag to get its name
const { data: tagDetails } = await supabase
  .from('blog_tags')
  .select('*')
  .eq('slug', tag)
  .single();

const tagName = tagDetails?.name || tag;

// Fetch posts with this tag
const { data: posts } = await supabase
  .from('blog_posts')
  .select('*, blog_categories(*)')
  .eq('status', 'published')
  .order('published_at', { ascending: false });

// Filter posts by tag (doing it in JS for simplicity with many-to-many if nested query is complex)
// Ideally we'd do this in the query, but we need the junction table join
const { data: taggedPostIds } = await supabase
  .from('blog_post_tags')
  .select('post_id, blog_tags!inner(slug)')
  .eq('blog_tags.slug', tag);

const postIds = taggedPostIds?.map(t => t.post_id) || [];
const filteredPosts = posts?.filter(p => postIds.includes(p.id)) || [];
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tag: {tagName} - Blog PreTalk</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-black">
    <LandingLayout client:load forceScrolled={true}>
      <div class="pt-20 bg-white">
        <div class="max-w-7xl mx-auto px-6 md:px-8 mt-12 bg-neutral-900 p-12 rounded-[40px] text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary-500/10 blur-[80px] translate-x-1/2 -translate-y-1/2" />
          <div class="relative z-10">
            <h1 class="text-4xl md:text-5xl font-black tracking-tighter mb-4">
              Tag : <span class="text-primary-400">#{tagName}</span>
            </h1>
            <p class="text-neutral-400 font-medium max-w-2xl text-lg">
              Articles et ressources tagués avec {tagName}.
            </p>
          </div>
        </div>
      </div>
      <Blog client:load initialPosts={filteredPosts} showHero={false} showFilters={false} showNewsletter={false} />
    </LandingLayout>
  </body>
</html>
